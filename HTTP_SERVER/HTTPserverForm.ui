           </widget>
          </item>

          <item>
           <widget class="QCheckBox" name="checkBox_2">
            <property name="text"><string>Многопоточная загрузка больших файлов</string></property>
            <property name="checked"><bool>true</bool></property>
           </widget>
          </item>

          <item>
           <layout class="QHBoxLayout" name="threadLayout">
            <property name="spacing"><number>8</number></property>
            <item><widget class="QLabel" name="labelThreadHint"><property name="text"><string>Применять для файлов более</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
            <item><widget class="QLineEdit" name="lineEdit_2"><property name="text"><string>100</string></property><property name="maximumWidth"><number>90</number></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
            <item><widget class="QLabel" name="labelThreadUnit"><property name="text"><string>МБ</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
            <item><spacer name="threadSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
           </layout>
          </item>

          <item>
           <spacer name="settingsBottomSpacer">
            <property name="orientation"><enum>Qt::Vertical</enum></property>
            <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
           </spacer>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>

