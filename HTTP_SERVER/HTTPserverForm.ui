<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>HTTPserverForm</class>
 <widget class="QWidget" name="HTTPserverForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1100</width>
    <height>760</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>ARDA — Управление сервером</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
    QWidget#HTTPserverForm {
        background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #161625, stop:1 #0c0c14);
        font-family: "Segoe UI", sans-serif;
        font-size: 10pt;
        color: #d1d1e0;
    }

    QFrame#topBar      { background-color: rgba(51,144,236,0.05); border: 1px solid rgba(51,144,236,0.15); border-radius: 12px; }
    QFrame#actionsPanel{ background-color: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; }
    QFrame#logPanel    { background-color: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; }
    QFrame#statusCard  { background-color: rgba(34,197,94,0.05);  border: 1px solid rgba(34,197,94,0.15);  border-radius: 14px; }
    QFrame#progressCard{ background-color: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 14px; }
    QFrame#connectionCard { background-color: rgba(51,144,236,0.04); border: 1px solid rgba(51,144,236,0.15); border-radius: 14px; }
    QFrame#helpCard    { background-color: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 14px; }
    QFrame#registerCard{ background-color: rgba(168,85,247,0.04);  border: 1px solid rgba(168,85,247,0.15);  border-radius: 14px; }
    QFrame#settingsCard{ background-color: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 14px; }
    QFrame#managerCard { background-color: rgba(245,158,11,0.04);  border: 1px solid rgba(245,158,11,0.15);  border-radius: 14px; }

    QLabel#labelSection1 { color:#5ba8ff; font-size:11px; font-weight:700; letter-spacing:2px; }
    QLabel#labelSection2 { color:#c084fc; font-size:11px; font-weight:700; letter-spacing:2px; }
    QLabel#labelSection3 { color:#4ade80; font-size:11px; font-weight:700; letter-spacing:2px; }
    QLabel#labelSection4 { color:#fbbf24; font-size:11px; font-weight:700; letter-spacing:2px; }
    QLabel#labelHint     { color:#8e8e9e; font-size:10pt; }

    QLabel#labelStatusValue { color:#ffffff; font-size:16pt; font-weight:700; }
    QLabel#labelStatusRights{ color:#8e8e9e; font-size:10pt; }
    QLabel#labelServerCurrentPath {
        color:#5ba8ff;
        font-family: Consolas, monospace;
        padding: 4px 8px;
        background: rgba(51,144,236,0.08);
        border-radius: 6px;
    }

    QPushButton {
        background-color: #1e1e2e;
        border: 1px solid #2e2e42;
        border-radius: 10px;
        color: #d1d1e0;
        font-weight: 600;
        padding: 10px 14px;
        text-align: left;
        min-height: 20px;
    }
    QPushButton:hover   { background-color: #252538; color: #ffffff; }
    QPushButton:pressed { background-color: #1a1a28; }
    QPushButton:disabled{ color: #555566; background-color: #151520; }

    QPushButton#btnBackDir { padding: 8px 14px; min-width: 40px; text-align:center; }
    QPushButton#btnUpdate  { padding: 8px 14px; }

    QPushButton#btnDeleteServer {
        background-color:#3a1414; border:1px solid #7f1d1d; color:#fecaca;
    }
    QPushButton#btnDeleteServer:hover { background-color:#7f1d1d; color:#ffffff; }

    QPushButton#pushButton,
    QPushButton#btnRegestration {
        background-color:#2563eb; border:1px solid #3b82f6; color:#ffffff; text-align:center;
    }
    QPushButton#pushButton:hover,
    QPushButton#btnRegestration:hover { background-color:#3b82f6; }

    QLineEdit, QComboBox {
        background-color: #0f0f18;
        border: 1px solid #2e2e42;
        border-radius: 8px;
        padding: 8px 10px;
        color: #e0e0e0;
        selection-background-color: #2563eb;
        selection-color: #ffffff;
    }
    QLineEdit:focus, QComboBox:focus { border: 1px solid #3390EC; }

    QTextEdit {
        background-color: #0a0a12;
        border: 1px solid #1e1e2e;
        border-radius: 10px;
        padding: 8px;
        color: #a8f0a8;
        font-family: "Consolas", "Courier New", monospace;
        font-size: 10pt;
        selection-background-color: #2563eb;
    }

    QTreeView {
        background-color: #0f0f18;
        border: 1px solid #1e1e2e;
        border-radius: 10px;
        padding: 4px;
        alternate-background-color: #131320;
        selection-background-color: #2563eb;
        selection-color: #ffffff;
        outline: none;
    }
    QTreeView::item { padding: 4px 6px; border-radius: 6px; }
    QTreeView::item:hover { background-color: #1a1a2e; }
    QTreeView::item:selected { background-color: #2563eb; color: #ffffff; }

    QHeaderView::section {
        background-color: #1a1a2e;
        color: #8e8e9e;
        border: none;
        border-bottom: 1px solid #2e2e42;
        padding: 6px 8px;
        font-weight: 700;
    }

    QProgressBar {
        border: 1px solid #2e2e42;
        border-radius: 8px;
        text-align: center;
        background-color: #0f0f18;
        color: #d1d1e0;
        min-height: 22px;
    }
    QProgressBar::chunk {
        background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #2563eb, stop:1 #60a5fa);
        border-radius: 7px;
    }

    QTabWidget::pane {
        border: 1px solid #1e1e2e;
        border-radius: 12px;
        background-color: rgba(255, 255, 255, 0.01);
        top: -1px;
    }
    QTabBar::tab {
        background-color: #1a1a2e;
        color: #8e8e9e;
        border: 1px solid #1e1e2e;
        border-bottom: none;
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
        padding: 9px 18px;
        margin-right: 3px;
        font-weight: 600;
    }
    QTabBar::tab:selected { background-color: #2563eb; color: #ffffff; }
    QTabBar::tab:hover:!selected { background-color: #252540; color: #d1d1e0; }

    QCheckBox { color: #d1d1e0; spacing: 8px; }
    QCheckBox::indicator {
        width: 18px; height: 18px;
        border: 1px solid #2e2e42;
        border-radius: 5px;
        background-color: #0f0f18;
    }
    QCheckBox::indicator:checked {
        background-color: #2563eb;
        border: 1px solid #3b82f6;
    }
   </string>
  </property>

  <layout class="QVBoxLayout" name="rootLayout">
   <property name="leftMargin"><number>16</number></property>
   <property name="topMargin"><number>16</number></property>
   <property name="rightMargin"><number>16</number></property>
   <property name="bottomMargin"><number>16</number></property>
   <property name="spacing"><number>12</number></property>

   <item>
    <widget class="QTabWidget" name="tabWidget">
     <property name="currentIndex"><number>0</number></property>

     <!-- ================= МЕНЕДЖЕР ОБМЕНА ================= -->
     <widget class="QWidget" name="tab_Main">
      <attribute name="title"><string>Менеджер обмена</string></attribute>

      <layout class="QVBoxLayout" name="tabMainLayout">
       <property name="leftMargin"><number>12</number></property>
       <property name="topMargin"><number>12</number></property>
       <property name="rightMargin"><number>12</number></property>
       <property name="bottomMargin"><number>12</number></property>
       <property name="spacing"><number>10</number></property>

       <item>
        <widget class="QFrame" name="topBar">
         <layout class="QHBoxLayout" name="topBarLayout">
          <property name="leftMargin"><number>10</number></property>
          <property name="topMargin"><number>8</number></property>
          <property name="rightMargin"><number>10</number></property>
          <property name="bottomMargin"><number>8</number></property>
          <property name="spacing"><number>8</number></property>

          <item>
           <widget class="QPushButton" name="btnBackDir">
            <property name="text"><string>←</string></property>
            <property name="toolTip"><string>Перейти в прошлую директорию</string></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnUpdate">
            <property name="text"><string>Обновить</string></property>
            <property name="toolTip"><string>Обновить список файлов</string></property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="labelServerCurrentPath">
            <property name="text"><string>/</string></property>
           </widget>
          </item>
          <item>
           <spacer name="topBarSpacer">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
           </spacer>
          </item>
         </layout>
        </widget>
       </item>

       <item>
        <layout class="QHBoxLayout" name="mainAreaLayout">
         <property name="spacing"><number>10</number></property>

         <item>
          <widget class="QFrame" name="actionsPanel">
           <property name="minimumWidth"><number>210</number></property>
           <property name="maximumWidth"><number>230</number></property>
           <layout class="QVBoxLayout" name="actionsLayout">
            <property name="leftMargin"><number>12</number></property>
            <property name="topMargin"><number>12</number></property>
            <property name="rightMargin"><number>12</number></property>
            <property name="bottomMargin"><number>12</number></property>
            <property name="spacing"><number>8</number></property>

            <item>
             <widget class="QLabel" name="labelActionsTitle">
              <property name="text"><string>ДЕЙСТВИЯ</string></property>
              <property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10px; font-weight:700; letter-spacing:2px;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnUpload">
              <property name="text"><string>⬆  Загрузить на сервер</string></property>
              <property name="toolTip"><string>Загрузить файл с вашего ПК на сервер</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnCopy">
              <property name="text"><string>⬇  Скачать с сервера</string></property>
              <property name="toolTip"><string>Скачать файл с сервера</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnMove">
              <property name="text"><string>↔  Переместить</string></property>
              <property name="toolTip"><string>Переместить файл с вашего ПК на сервер с удалением</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnDeleteServer">
              <property name="text"><string>✕  Удалить на сервере</string></property>
              <property name="toolTip"><string>Удалить файл на сервере</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btnViewMetaDataServerFile">
              <property name="text"><string>ℹ  Свойства файла</string></property>
              <property name="toolTip"><string>Просмотр метаданных файла</string></property>
             </widget>
            </item>
            <item>
             <spacer name="actionsSpacer">
              <property name="orientation"><enum>Qt::Vertical</enum></property>
              <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
             </spacer>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QTreeView" name="treeViewServerFS"/>
         </item>
        </layout>
       </item>

       <item>
        <widget class="QFrame" name="logPanel">
         <layout class="QVBoxLayout" name="logLayout">
          <property name="leftMargin"><number>12</number></property>
          <property name="topMargin"><number>10</number></property>
          <property name="rightMargin"><number>12</number></property>
          <property name="bottomMargin"><number>12</number></property>
          <property name="spacing"><number>6</number></property>
          <item>
           <widget class="QLabel" name="labelLogTitle">
            <property name="text"><string>ЖУРНАЛ ОПЕРАЦИЙ</string></property>
            <property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10px; font-weight:700; letter-spacing:2px;</string></property>
           </widget>
          </item>
          <item>
           <widget class="QTextEdit" name="textEditLogLocal">
            <property name="readOnly"><bool>true</bool></property>
            <property name="minimumHeight"><number>110</number></property>
            <property name="maximumHeight"><number>160</number></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- ================= СТАТУС ================= -->
     <widget class="QWidget" name="tab_Staus">
      <attribute name="title"><string>Статус</string></attribute>

      <layout class="QVBoxLayout" name="tabStatusLayout">
       <property name="leftMargin"><number>12</number></property>
       <property name="topMargin"><number>12</number></property>
       <property name="rightMargin"><number>12</number></property>
       <property name="bottomMargin"><number>12</number></property>
       <property name="spacing"><number>12</number></property>

       <item>
        <widget class="QFrame" name="statusCard">
         <layout class="QHBoxLayout" name="statusCardLayout">
          <property name="leftMargin"><number>16</number></property>
          <property name="topMargin"><number>14</number></property>
          <property name="rightMargin"><number>16</number></property>
          <property name="bottomMargin"><number>14</number></property>
          <property name="spacing"><number>12</number></property>
          <item>
           <layout class="QVBoxLayout" name="statusTextLayout">
            <property name="spacing"><number>2</number></property>
