            <item><widget class="QLabel" name="labelIntervalHint"><property name="text"><string>Интервал обновления:</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
            <item><widget class="QLineEdit" name="lineEdit"><property name="text"><string>5</string></property><property name="maximumWidth"><number>80</number></property><property name="alignment"><set>Qt::AlignCenter</set></property></widget></item>
            <item><widget class="QLabel" name="labelIntervalUnit"><property name="text"><string>секунд</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
