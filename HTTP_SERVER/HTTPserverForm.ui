         <layout class="QGridLayout" name="progressGrid">
          <property name="leftMargin"><number>16</number></property>
          <property name="topMargin"><number>16</number></property>
          <property name="rightMargin"><number>16</number></property>
          <property name="bottomMargin"><number>16</number></property>
          <property name="horizontalSpacing"><number>24</number></property>
          <property name="verticalSpacing"><number>12</number></property>

          <item row="0" column="0">
           <widget class="QLabel" name="labelUploadHeader">
            <property name="text"><string>ВЫГРУЗКА НА СЕРВЕР</string></property>
