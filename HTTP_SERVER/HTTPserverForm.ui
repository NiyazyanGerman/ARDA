     <!-- ================= ПОДКЛЮЧЕНИЕ ================= -->
     <widget class="QWidget" name="tab_Data">
      <attribute name="title"><string>Подключение</string></attribute>

      <layout class="QVBoxLayout" name="tabDataLayout">
       <property name="leftMargin"><number>12</number></property>
       <property name="topMargin"><number>12</number></property>
       <property name="rightMargin"><number>12</number></property>
       <property name="bottomMargin"><number>12</number></property>
       <property name="spacing"><number>12</number></property>

       <item>
        <widget class="QFrame" name="connectionCard">
         <layout class="QVBoxLayout" name="connectionLayout">
          <property name="leftMargin"><number>20</number></property>
          <property name="topMargin"><number>18</number></property>
          <property name="rightMargin"><number>20</number></property>
          <property name="bottomMargin"><number>18</number></property>
          <property name="spacing"><number>8</number></property>

          <item>
           <widget class="QLabel" name="labelConnTitle">
            <property name="text"><string>ПОДКЛЮЧЕНИЕ К СЕРВЕРУ</string></property>
            <property name="styleSheet"><string notr="true">color:#5ba8ff; font-size:11px; font-weight:700; letter-spacing:2px;</string></property>
           </widget>
          </item>

          <item><widget class="QLabel" name="labelHintIP"><property name="text"><string>IP-адрес</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
          <item><widget class="QLineEdit" name="lineEditIP"><property name="placeholderText"><string>Например: 192.168.1.100</string></property></widget></item>

          <item><widget class="QLabel" name="labelHintPort"><property name="text"><string>Порт (необязательно)</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
          <item><widget class="QLineEdit" name="lineEditPort"><property name="placeholderText"><string>По умолчанию 443</string></property></widget></item>

          <item><widget class="QLabel" name="labelHintLogin"><property name="text"><string>Логин администратора</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
          <item><widget class="QLineEdit" name="lineEditLogin"><property name="placeholderText"><string>admin</string></property></widget></item>

          <item><widget class="QLabel" name="labelHintPassword"><property name="text"><string>Пароль</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
          <item><widget class="QLineEdit" name="lineEditPassword"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="placeholderText"><string>••••••••</string></property></widget></item>

          <item>
           <spacer name="connSpacer">
            <property name="orientation"><enum>Qt::Vertical</enum></property>
            <property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property>
           </spacer>
          </item>

          <item>
           <layout class="QHBoxLayout" name="connButtonLayout">
            <item>
             <spacer name="connButtonSpacer">
              <property name="orientation"><enum>Qt::Horizontal</enum></property>
              <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
             </spacer>
            </item>
            <item>
             <widget class="QPushButton" name="pushButton">
              <property name="text"><string>Подключиться</string></property>
              <property name="minimumWidth"><number>180</number></property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- ================= ПОМОЩЬ ================= -->
     <widget class="QWidget" name="tab_Help">
      <attribute name="title"><string>Помощь</string></attribute>

      <layout class="QVBoxLayout" name="tabHelpLayout">
       <property name="leftMargin"><number>12</number></property>
       <property name="topMargin"><number>12</number></property>
       <property name="rightMargin"><number>12</number></property>
       <property name="bottomMargin"><number>12</number></property>
       <property name="spacing"><number>12</number></property>

       <item>
        <layout class="QHBoxLayout" name="helpRow">
         <property name="spacing"><number>12</number></property>

         <item>
          <widget class="QFrame" name="helpCard">
           <layout class="QVBoxLayout" name="helpCardLayout">
            <property name="leftMargin"><number>16</number></property>
            <property name="topMargin"><number>16</number></property>
            <property name="rightMargin"><number>16</number></property>
            <property name="bottomMargin"><number>16</number></property>
            <property name="spacing"><number>10</number></property>

            <item>
             <widget class="QLabel" name="labelHelpTitle">
              <property name="text"><string>ОСНОВНЫЕ ПРАВИЛА</string></property>
              <property name="styleSheet"><string notr="true">color:#5ba8ff; font-size:11px; font-weight:700; letter-spacing:2px;</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="labeliInfo">
              <property name="text"><string>&lt;b&gt;1. Передача файлов&lt;/b&gt;&lt;br&gt;1.1 Используйте передачу файлов только при работающем интернете и запущенном сервере.&lt;br&gt;1.2 Файлы более 100 МБ загружаются в многопоточном режиме.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Рекомендации&lt;/b&gt;&lt;br&gt;2.1 Делайте резервные копии важных данных.&lt;br&gt;2.2 Не скачивайте нежелательное ПО.&lt;br&gt;2.3 Не сообщайте никому порт сервера.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Права доступа&lt;/b&gt;&lt;br&gt;0 — Наблюдатель&lt;br&gt;1 — Преподаватель&lt;br&gt;2 — Повышенный пользователь&lt;br&gt;3 — Администратор</string></property>
              <property name="wordWrap"><bool>true</bool></property>
              <property name="textFormat"><enum>Qt::RichText</enum></property>
              <property name="styleSheet"><string notr="true">color:#d1d1e0; font-size:10pt;</string></property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QFrame" name="registerCard">
           <property name="minimumWidth"><number>320</number></property>
           <property name="maximumWidth"><number>360</number></property>
           <layout class="QVBoxLayout" name="registerLayout">
            <property name="leftMargin"><number>16</number></property>
            <property name="topMargin"><number>16</number></property>
            <property name="rightMargin"><number>16</number></property>
            <property name="bottomMargin"><number>16</number></property>
            <property name="spacing"><number>8</number></property>

            <item>
             <widget class="QLabel" name="labelRegTitle">
              <property name="text"><string>РЕГИСТРАЦИЯ</string></property>
              <property name="styleSheet"><string notr="true">color:#c084fc; font-size:11px; font-weight:700; letter-spacing:2px;</string></property>
             </widget>
            </item>

            <item><widget class="QLabel" name="labelRegHintLogin"><property name="text"><string>Логин</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
            <item><widget class="QLineEdit" name="lineEditLoginRegister"><property name="placeholderText"><string>Придумайте логин</string></property></widget></item>

            <item><widget class="QLabel" name="labelRegHintPass"><property name="text"><string>Пароль</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
            <item><widget class="QLineEdit" name="lineEditPasswordRegister"><property name="echoMode"><enum>QLineEdit::Password</enum></property><property name="placeholderText"><string>••••••••</string></property></widget></item>

            <item><widget class="QLabel" name="labelRegHintRights"><property name="text"><string>Запрашиваемые права</string></property><property name="styleSheet"><string notr="true">color:#8e8e9e; font-size:10pt;</string></property></widget></item>
            <item>
             <widget class="QComboBox" name="comboBoxPermisionRegister">
              <property name="currentIndex"><number>0</number></property>
              <item><property name="text"><string>0 — Наблюдатель</string></property></item>
              <item><property name="text"><string>1 — Преподаватель</string></property></item>
              <item><property name="text"><string>2 — Повышенный пользователь</string></property></item>
              <item><property name="text"><string>3 — Администратор</string></property></item>
             </widget>
            </item>

            <item>
             <widget class="QLabel" name="labelRegHintInfo">
              <property name="text"><string>После генерации логина передайте его в ИТ-отдел для выдачи прав.</string></property>
              <property name="wordWrap"><bool>true</bool></property>
              <property name="styleSheet"><string notr="true">color:#6c6c80; font-size:9pt; padding-top: 4px;</string></property>
             </widget>
            </item>

            <item>
             <spacer name="regSpacer">
              <property name="orientation"><enum>Qt::Vertical</enum></property>
              <property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property>
             </spacer>
            </item>

            <item>
             <widget class="QPushButton" name="btnRegestration">
              <property name="text"><string>Зарегистрироваться</string></property>
              <property name="minimumHeight"><number>38</number></property>
             </widget>
            </item>
           </layout>
          </widget>
         </item>
        </layout>
       </item>
      </layout>
     </widget>

     <!-- ================= НАСТРОЙКИ ================= -->
     <widget class="QWidget" name="tab_Settings">
      <attribute name="title"><string>Настройки</string></attribute>

