  <property name="styleSheet">
   <string notr="true">/* ===== Base ===== */
QWidget {
    background-color: #2b2f38;
    color: #e6e6e6;
    font-family: &quot;Segoe UI&quot;;
    font-size: 13px;
}

/* ===== Sidebar Buttons ===== */
QPushButton {
    background-color: #3a404b;
    border: 1px solid #4a5160;
    border-radius: 10px;
    padding: 8px;
}

QPushButton:hover {
    background-color: #444b57;
}

QPushButton:pressed {
    background-color: #2d313a;
}

/* Primary button (Сохранить) */
QPushButton#saveButton {
    background-color: #3da561;
    border: none;
    border-radius: 8px;
    padding: 8px;
    color: white;
}

QPushButton#saveButton:hover {
    background-color: #45b86c;
}

QPushButton#saveButton:pressed {
    background-color: #2f8f52;
}


/* ===== ComboBox ===== */
QComboBox {
    background-color: #3a404b;
    border: 1px solid #505765;
    border-radius: 6px;
    padding: 6px;
}

QComboBox:hover {
    border: 1px solid #6c7486;
}

QComboBox::drop-down {
    border: none;
}

QComboBox QAbstractItemView {
    background-color: #2b2f38;
    border: 1px solid #3da561;
    selection-background-color: #3da561;
}


/* ===== LineEdit ===== */
QLineEdit {
    background-color: #3a404b;
    border: 1px solid #505765;
    border-radius: 6px;
    padding: 6px;
}

QLineEdit:focus {
    border: 1px solid #3da561;
}


/* ===== QListWidget ===== */
QListWidget {
    background-color: #262a33;
    border: 1px solid #3f4654;
    border-radius: 8px;
    padding: 4px;
    outline: none;
}

QListWidget::item {
    background-color: transparent;
    padding: 6px;
    border-radius: 6px;
}

QListWidget::item:hover {
    background-color: #353b47;
}

QListWidget::item:selected {
    background-color: #3da561;
    color: white;
}

QListWidget::item:selected:hover {
    background-color: #45b86c;
}


/* ===== ScrollBar ===== */
QScrollBar:vertical {
    background: #2b2f38;
    width: 10px;
    margin: 2px;
}

QScrollBar::handle:vertical {
    background: #4a5160;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #5c6475;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}


/* ===== Calendar ===== */
QCalendarWidget QWidget {
    alternate-background-color: #2b2f38;
}

QCalendarWidget QToolButton {
    background-color: #3a404b;
    border: none;
    border-radius: 6px;
    padding: 4px;
}

QCalendarWidget QToolButton:hover {
    background-color: #4a5160;
}

QCalendarWidget QAbstractItemView {
    selection-background-color: #3da561;
    selection-color: white;
    background-color: #262a33;
}


/* ===== GroupBox (если используешь) ===== */
QGroupBox {
    border: 1px solid #3f4654;
    border-radius: 8px;
    margin-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px 0 5px;
}</string>
